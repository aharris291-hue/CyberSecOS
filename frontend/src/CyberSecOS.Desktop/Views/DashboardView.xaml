<UserControl x:Class="CyberSecOS.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <Style x:Key="ChartTitle" TargetType="TextBlock" BasedOn="{StaticResource SubheadingText}">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource HeadingText}" />
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,4,0,16" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <!-- Next step -->
            <Border Style="{StaticResource Card}" BorderBrush="{StaticResource AccentBrush}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="UP NEXT" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NextLesson.Title}" Style="{StaticResource SubheadingText}" FontSize="19" Margin="0,4,0,4"
                                   Visibility="{Binding HasNextLesson, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding NextLessonCaption}" Style="{StaticResource MutedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Browse courses" Command="{Binding BrowseCoursesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                        <Button Content="{Binding NextLessonActionLabel}" Command="{Binding ContinueLearningCommand}" Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding HasNextLesson, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Headline numbers -->
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:StatTile}">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <TextBlock Text="{Binding Caption}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Weekly goal -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Weekly goal" Style="{StaticResource ChartTitle}" Margin="0" />
                        <TextBlock Text="{Binding WeekSummary}" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>
                    <ProgressBar Value="{Binding WeekGoalPercent, Mode=OneWay}" Maximum="100" Height="10"
                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Charts -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Study time, last 14 days (minutes)" Style="{StaticResource ChartTitle}" />
                        <Grid Height="240">
                            <lvc:CartesianChart Series="{Binding ActivityChart, Converter={StaticResource ChartSeries}, ConverterParameter=stacked}"
                                                XAxes="{Binding ActivityChart, Converter={StaticResource ChartAxis}, ConverterParameter=category}"
                                                YAxes="{Binding ActivityChart, Converter={StaticResource ChartAxis}, ConverterParameter=value}"
                                                LegendPosition="Bottom" />
                            <TextBlock Text="Complete a lesson's theory or lab to see your study time here."
                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasStudied, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Theory vs hands-on" Style="{StaticResource ChartTitle}" />
                        <Grid Height="240">
                            <lvc:PieChart Series="{Binding StudyMixChart, Converter={StaticResource ChartSeries}, ConverterParameter=pie}"
                                          LegendPosition="Bottom" />
                            <TextBlock Text="Target: 20% theory, 80% labs" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding HasStudied, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Progress by domain" Style="{StaticResource ChartTitle}" />
                        <lvc:CartesianChart Height="280"
                                            Series="{Binding DomainChart, Converter={StaticResource ChartSeries}, ConverterParameter=rows}"
                                            YAxes="{Binding DomainChart, Converter={StaticResource ChartAxis}, ConverterParameter=category}"
                                            XAxes="{Binding DomainChart, Converter={StaticResource ChartAxis}, ConverterParameter=value}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Certification readiness" Style="{StaticResource ChartTitle}" />
                        <lvc:CartesianChart Height="280"
                                            Series="{Binding CertificationChart, Converter={StaticResource ChartSeries}, ConverterParameter=rows}"
                                            YAxes="{Binding CertificationChart, Converter={StaticResource ChartAxis}, ConverterParameter=category}"
                                            XAxes="{Binding CertificationChart, Converter={StaticResource ChartAxis}, ConverterParameter=value}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent activity -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent activity" Style="{StaticResource ChartTitle}" />
                    <TextBlock Text="Nothing yet. Your first lab is waiting." Style="{StaticResource MutedText}"
                               Visibility="{Binding HasStudied, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityItem}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MutedText}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
