<UserControl x:Class="CyberSecOS.Desktop.Views.ExamsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
             xmlns:m="clr-namespace:CyberSecOS.Core.Models;assembly=CyberSecOS.Core"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Practice Exams" Style="{StaticResource HeadingText}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16"
                       Text="Sit a timed, scored mock exam sampled across a certification's objectives, then see where to focus next." />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <!-- Setup -->
            <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageVisibility}, ConverterParameter=Setup}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Choose a certification" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ExamOptionViewModel}">
                                    <RadioButton GroupName="Cert" Margin="0,4"
                                                 Foreground="{StaticResource TextPrimaryBrush}"
                                                 Command="{Binding DataContext.SelectCommand, ElementName=Root}" CommandParameter="{Binding}">
                                        <RadioButton.Style>
                                            <Style TargetType="RadioButton">
                                                <Setter Property="IsChecked" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="IsChecked" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AvailableQuestions}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </RadioButton.Style>
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  (" /><Run Text="{Binding ExamCode, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource MutedText}">
                                                <Run Text="{Binding AvailableQuestions, Mode=OneWay}" /><Run Text=" questions available  ·  " /><Run Text="{Binding BestSummary, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding TargetSummary}" Style="{StaticResource MutedText}" Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Exam length" Style="{StaticResource SubheadingText}" Margin="0,0,0,8" />
                        <Slider Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                Value="{Binding QuestionCount}" Width="400" HorizontalAlignment="Left" />
                        <TextBlock Text="{Binding LengthCaption}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Target exam date" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                        <TextBlock Text="Set the date you plan to sit this exam to see a countdown here and on your progress." Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding TargetDateInput, UpdateSourceTrigger=PropertyChanged}" Width="160" VerticalContentAlignment="Center"
                                     ToolTip="YYYY-MM-DD" />
                            <Button Content="Set date" Command="{Binding SetTargetCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" />
                            <Button Content="Clear" Command="{Binding ClearTargetCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedExam.TargetSummary}" Style="{StaticResource MutedText}" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Button Content="Start exam" Command="{Binding StartExamCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Taking -->
            <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageVisibility}, ConverterParameter=Taking}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ProgressCaption}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Elapsed " Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ElapsedDisplay}" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Questions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuizQuestionViewModel}">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Prompt}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:QuizOptionViewModel}">
                                                <RadioButton IsChecked="{Binding IsSelected}" Margin="0,2" Foreground="{StaticResource TextPrimaryBrush}">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Submit exam" Command="{Binding SubmitExamCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Cancel" Command="{Binding BackToSetupCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </StackPanel>

            <!-- Results -->
            <StackPanel Visibility="{Binding Stage, Converter={StaticResource StageVisibility}, ConverterParameter=Results}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultHeadline}" Style="{StaticResource SubheadingText}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0">
                            <Run Text="{Binding Result.Correct, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding Result.Total, Mode=OneWay}" /><Run Text=" correct" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                        Visibility="{Binding WeakAreas.Count, Converter={StaticResource NotEmptyToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Focus areas" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                        <TextBlock Text="Objectives below the pass mark. Review the matching courses, then retake." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding WeakAreas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type m:ObjectiveScore}">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" TextWrapping="Wrap">
                                            <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8"
                                                     Foreground="{StaticResource DangerBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" VerticalAlignment="Center" TextAlignment="Right">
                                            <Run Text="{Binding Correct, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding Total, Mode=OneWay}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Back to exams" Command="{Binding BackToSetupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Browse courses" Command="{Binding BrowseCoursesCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
