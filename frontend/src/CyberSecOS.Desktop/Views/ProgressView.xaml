<UserControl x:Class="CyberSecOS.Desktop.Views.ProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
             xmlns:m="clr-namespace:CyberSecOS.Core.Models;assembly=CyberSecOS.Core"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Progress" Style="{StaticResource HeadingText}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,16">
                <Run Text="{Binding Totals.CompletedLessons, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding Totals.TotalLessons, Mode=OneWay}" /><Run Text=" lessons complete  ·  " /><Run Text="{Binding StudyTime, Mode=OneWay}" /><Run Text=" studied  ·  " /><Run Text="{Binding HandsOnSummary, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Courses" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Courses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:CourseProgress}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Run Text="{Binding CompletedLessons, Mode=OneWay}" /><Run Text="/" /><Run Text="{Binding TotalLessons, Mode=OneWay}" />
                                    </TextBlock>
                                    <Button Grid.Column="3" Content="Open" Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.OpenCourseCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Certification readiness" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                    <TextBlock Text="Share of each exam's objectives covered by lessons you have completed." Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Certifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:CertificationProgress}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ExamCode, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource MutedText}" Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding DaysUntilExam, Converter={StaticResource ExamCountdown}}"
                                                   Visibility="{Binding TargetDate, Converter={StaticResource NotNullToVisibility}}" />
                                    </StackPanel>
                                    <ProgressBar Grid.Column="1" Value="{Binding ReadinessPercent, Mode=OneWay}" Maximum="100" Height="8"
                                                 Foreground="{StaticResource SuccessBrush}" Background="{StaticResource SurfaceRaisedBrush}" BorderThickness="0" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,0">
                                        <Run Text="{Binding ObjectivesMastered, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding ObjectivesTotal, Mode=OneWay}" /><Run Text=" objectives" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recent activity" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding QuizSummary}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding RecentActivity}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityItem}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" />
                                    <TextBlock Grid.Column="1" Text="{Binding When}" Style="{StaticResource MutedText}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource MutedText}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
