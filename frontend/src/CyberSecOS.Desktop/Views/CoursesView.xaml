<UserControl x:Class="CyberSecOS.Desktop.Views.CoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:CyberSecOS.Core.Models;assembly=CyberSecOS.Core"
             x:Name="Root">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,20">
            <TextBlock Text="Courses" Style="{StaticResource HeadingText}" />
            <TextBlock Text="Every lesson is about 20% theory and 80% hands-on lab work." Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourse}"
                 Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type m:CourseSummary}">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding Domain}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,2,0,6" />
                            <TextBlock Style="{StaticResource MutedText}">
                                <Run Text="{Binding CompletedLessons, Mode=OneWay}" /><Run Text=" of " /><Run Text="{Binding LessonCount, Mode=OneWay}" /><Run Text=" lessons completed" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <TextBlock Text="{Binding CourseDetail.Title}" Style="{StaticResource SubheadingText}" FontSize="20" />
                    <TextBlock Text="{Binding CourseDetail.Description}" Style="{StaticResource BodyText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Lessons}">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:LessonSummary}">
                            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="16" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold">
                                            <Run Text="{Binding Order, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,4,0,6" />
                                        <TextBlock Style="{StaticResource MutedText}">
                                            <Run Text="{Binding Difficulty, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding TheoryMinutes, Mode=OneWay}" /><Run Text=" min theory  ·  " /><Run Text="{Binding LabMinutes, Mode=OneWay}" /><Run Text=" min lab  ·  " /><Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusLabel}}" Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Open" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding DataContext.OpenLessonCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
