<UserControl x:Class="CyberSecOS.Desktop.Views.LessonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
             xmlns:m="clr-namespace:CyberSecOS.Core.Models;assembly=CyberSecOS.Core"
             xmlns:t="clr-namespace:CyberSecOS.Core.Text;assembly=CyberSecOS.Core"
             xmlns:b="clr-namespace:CyberSecOS.Desktop.Behaviors">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubheadingText}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Code" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="900" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Left" Content="← Back to course" Command="{Binding BackToCourseCommand}" Style="{StaticResource SecondaryButton}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Previous" Command="{Binding PreviousLessonCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                    <Button Content="Next" Command="{Binding NextLessonCommand}" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Lesson.CourseTitle}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,12,0,2" />
            <TextBlock Text="{Binding Lesson.Title}" Style="{StaticResource HeadingText}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,4">
                <Run Text="{Binding TheoryShare, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Lesson.Status, Mode=OneWay, Converter={StaticResource StatusLabel}}" Foreground="{Binding Lesson.Status, Converter={StaticResource StatusBrush}}" />
            </TextBlock>
            <TextBlock Text="{Binding CertificationTags}" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
            <Border Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="6" Padding="12,8" Margin="0,0,0,12"
                    Visibility="{Binding ProgressChecklist, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBlock Text="{Binding ProgressChecklist}" Style="{StaticResource BodyText}" />
            </Border>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <!-- 1. Learning objectives -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Learning objectives" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Lesson.LearningObjectives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4"><Run Text="•  " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 2. Theory -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"><Run Text="Theory  " /><Run Text="{Binding Lesson.TheoryMinutes, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" /><Run Text=" min" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" /></TextBlock>
                    <ItemsControl ItemsSource="{Binding TheoryBlocks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type t:MarkdownParagraph}">
                                <TextBlock Style="{StaticResource BodyText}" LineHeight="22" TextWrapping="Wrap"
                                           Margin="0,0,0,10" b:MarkdownInlines.Runs="{Binding Runs}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Mark theory as read" Command="{Binding MarkTheoryReadCommand}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Margin="0,12,0,0"
                            Visibility="{Binding IsTheoryCompleted, Converter={StaticResource InverseBoolToVisibility}}" />
                    <TextBlock Text="✓ Theory read" Foreground="{StaticResource SuccessBrush}" Margin="0,12,0,0"
                               Visibility="{Binding IsTheoryCompleted, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- 3. Examples -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Examples" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Lesson.Examples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:Example}">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Body, Mode=OneWay}" Style="{StaticResource Code}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 4. Practical exercise -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{StaticResource AccentBrush}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"><Run Text="Practical exercise: " /><Run Text="{Binding Lesson.Exercise.Title, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,4"><Run Text="Environment: " /><Run Text="{Binding Lesson.Exercise.Environment, Mode=OneWay}" /></TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"><Run Text="Estimated time: " /><Run Text="{Binding Lesson.LabMinutes, Mode=OneWay}" /><Run Text=" minutes" /></TextBlock>
                    <ItemsControl ItemsSource="{Binding ExerciseSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NumberedStep}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                                               Text="{Binding Number, StringFormat={}{0}.}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text, Converter={StaticResource PlainText}}" Style="{StaticResource BodyText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource BodyText}" Margin="0,8,0,16"><Run Text="Deliverable: " FontWeight="SemiBold" /><Run Text="{Binding Lesson.Exercise.Deliverable, Mode=OneWay}" /></TextBlock>

                    <TextBlock Text="Lab notes (findings, commands, screenshots paths)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding LabNotes, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Minutes spent" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding LabMinutes, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="0,0,16,0" />
                        <Button Content="Mark lab complete" Command="{Binding CompleteLabCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                Visibility="{Binding IsLabCompleted, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="Save notes" Command="{Binding CompleteLabCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                                Visibility="{Binding IsLabCompleted, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="Reopen lab" Command="{Binding ReopenLabCommand}" Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding IsLabCompleted, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 5. Quiz -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Quiz" Style="{StaticResource SectionTitle}" />
                    <ItemsControl ItemsSource="{Binding Questions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:QuizQuestionViewModel}">
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="{Binding Prompt}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ItemsControl ItemsSource="{Binding Options}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:QuizOptionViewModel}">
                                                <RadioButton IsChecked="{Binding IsSelected}" Margin="0,2" Foreground="{StaticResource TextPrimaryBrush}"
                                                             IsEnabled="{Binding DataContext.IsGraded, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}, Converter={StaticResource InverseBool}}">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsCorrectAnswer}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource MutedText}" Margin="20,6,0,0"
                                               Visibility="{Binding Explanation, Converter={StaticResource NotEmptyToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding QuizSummary}" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,10"
                               Visibility="{Binding QuizSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Submit answers" Command="{Binding SubmitQuizCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                        <Button Content="Try again" Command="{Binding RetryQuizCommand}" Style="{StaticResource SecondaryButton}"
                                Visibility="{Binding QuizSummary, Converter={StaticResource NotEmptyToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 6. Expected outcome -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Expected outcome" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding Lesson.ExpectedOutcome}" Style="{StaticResource BodyText}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
