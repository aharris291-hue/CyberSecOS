<UserControl x:Class="CyberSecOS.Desktop.Views.LabsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Graded Labs" Style="{StaticResource HeadingText}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource BodyText}" Margin="0,4,0,4" TextWrapping="Wrap" />
            <TextBlock Text="Each lab gives you real-looking data to analyse; your answers are marked, and passing completes the lesson's lab."
                       Style="{StaticResource MutedText}" Margin="0,0,0,16" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <ItemsControl ItemsSource="{Binding Courses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:LabCourseGroup}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding CourseTitle}" Style="{StaticResource SubheadingText}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Labs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:LabItem}">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap">
                                                        <Run Text="{Binding LessonTitle, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Detail, Mode=OneWay}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="12,0"
                                                        Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4" Padding="10,4">
                                                    <TextBlock Text="{Binding StatusLabel}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Button Grid.Column="2" Content="Open" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenLabCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
