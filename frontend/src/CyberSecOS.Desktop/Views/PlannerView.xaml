<UserControl x:Class="CyberSecOS.Desktop.Views.PlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
             xmlns:m="clr-namespace:CyberSecOS.Core.Models;assembly=CyberSecOS.Core"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Study Plan" Style="{StaticResource HeadingText}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource BodyText}" Margin="0,4,0,4"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Pace toward each exam" Style="{StaticResource SubheadingText}" VerticalAlignment="Center" />
                        <Button Content="Edit exam dates" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                Command="{Binding EditExamDatesCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Certifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CertificationPaceItem}">
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ExamCode, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Background="{StaticResource SurfaceRaisedBrush}" CornerRadius="4" Padding="10,4">
                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MutedText}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Weekly schedule" Style="{StaticResource SubheadingText}" Margin="0,0,0,4" />
            <TextBlock Text="Lessons packed into weeks at your goal pace, soonest-exam work first."
                       Style="{StaticResource MutedText}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Weeks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PlanWeekItem}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Lessons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type m:PlannedLesson}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" />
                                                    <TextBlock Text="{Binding CourseTitle}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Open" Style="{StaticResource SecondaryButton}"
                                                        VerticalAlignment="Center"
                                                        Command="{Binding DataContext.OpenLessonCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
