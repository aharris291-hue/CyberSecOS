<UserControl x:Class="CyberSecOS.Desktop.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:CyberSecOS.Desktop.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="Profile" Style="{StaticResource HeadingText}" Margin="0,0,0,20" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVisibility}}" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="About you" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                    <TextBlock Text="Username" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Username}" Style="{StaticResource BodyText}" Margin="0,2,0,12" />
                    <TextBlock Text="Display name" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Target role" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TargetRole, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="Weekly study goal (hours)" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding WeeklyGoalHours, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,16" />
                    <Button Content="Save profile" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Change password" Style="{StaticResource SubheadingText}" Margin="0,0,0,12" />
                    <TextBlock Text="Current password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />
                    <TextBlock Text="New password" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
                    <PasswordBox b:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                    <Button Content="Change password" Command="{Binding ChangePasswordCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
