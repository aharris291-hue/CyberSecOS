<Window x:Class="CyberSecOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CyberSecOS.Core.ViewModels;assembly=CyberSecOS.Core"
        Title="CyberSecOS" Width="1280" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side navigation, only once signed in -->
        <Border Grid.Column="0" Width="220" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
            <DockPanel Margin="0,20,0,16">
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,24">
                    <TextBlock Text="CyberSecOS" Style="{StaticResource SubheadingText}" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="SOC Analyst track" Style="{StaticResource MutedText}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0">
                    <TextBlock Text="{Binding UserDisplayName}" Style="{StaticResource BodyText}" Margin="0,0,0,8" />
                    <Button Content="Sign out" Command="{Binding SignOutCommand}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                </StackPanel>
                <ListBox ItemsSource="{Binding NavigationItems}" SelectedItem="{Binding SelectedItem}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,10" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavigationItem}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />
    </Grid>
</Window>
